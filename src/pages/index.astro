---
import BaseLayout from "../layouts/BaseLayout.astro";
import JsonLd from "../components/JsonLd.astro";
import GitHubContributions from "../components/GitHubContributions.astro";
import GitHubRepos from "../components/GitHubRepos.astro";

const currently = [
  {
    label: "Consulting Engineer",
    detail: "Working with customer security, infrastructure, and application teams to figure out what they need and scope the work that follows.",
  },
  {
    label: "VP & Operations Lead, BSides Memphis",
    detail: "Volunteering on conference operations and running the organization's Google Workspace tenant.",
    href: "https://bsidesmemphis.org",
  },
];
---

<BaseLayout>
  <JsonLd type="Person" />

  <!-- Hero -->
  <div class="mb-5">
    <p class="text-xl py-1">Hey there!</p>
    <h1 class="text-4xl w-full font-bold">I'm John Dorion</h1>
    <p class="text-lg text-accent mt-2">Consulting engineer, security practitioner, Linux nerd.</p>
  </div>

  <div class="mb-12 text-justify">
    My background is in security operations: building detections in Splunk and CrowdStrike, working alerts, and
    figuring out what the data was actually trying to say. These days I spend most of my time on the consulting
    side, sitting down with customer teams to work out what they have, what they need it to do, and what it'll
    take to get there. Outside of work I'm usually tinkering with my homelab, competing in CTF competitions, or
    rebuilding something in NixOS for the third time.
  </div>

  <!-- Currently -->
  <h2 class="text-3xl w-full font-bold mb-5">Currently</h2>

  <ul class="mb-12 space-y-4">
    {
      currently.map((item) => (
        <li class="border-l-2 border-accent pl-4">
          <h3 class="font-bold">
            {item.href ? (
              <a href={item.href} target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">
                {item.label} &nearr;
              </a>
            ) : (
              item.label
            )}
          </h3>
          <p class="text-sm text-base-content/80">{item.detail}</p>
        </li>
      ))
    }
  </ul>

  <!-- GitHub activity -->
  <GitHubContributions username="0x6a64" />
  <GitHubRepos username="0x6a64" limit={6} />
</BaseLayout>
